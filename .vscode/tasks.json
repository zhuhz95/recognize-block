{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. 编译 colcon build",
      "type": "shell",
      "command": "source /opt/ros/humble/setup.bash && colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/bash",
          "args": [
            "-c"
          ]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "2. 启动图像+识别+rosbridge",
      "type": "shell",
      "command": "source /opt/ros/humble/setup.bash && source install/setup.bash && ros2 launch zhz_recognizedBall bringup.launch.xml",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/bash",
          "args": [
            "-c"
          ]
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "3. 调用服务识别绿色",
      "type": "shell",
      "command": "source /opt/ros/humble/setup.bash && source install/setup.bash && ros2 service call /detect_block zhz_interfaces/srv/DetectBlock \"{color: 'green'}\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/bash",
          "args": [
            "-c"
          ]
        }
      },
      "problemMatcher": []
    }
  ]
}
