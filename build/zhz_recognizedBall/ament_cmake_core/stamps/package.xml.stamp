<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zhz_recognizedBall</name>
  <version>1.0.0</version>
  <description>ROS 2 话题 + 服务作业：识别红/绿/蓝方块，并在 Foxglove 中显示图片和 ImageMarker。</description>

  <maintainer email="zhuhz@example.com">zhz</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>zhz_interfaces</depend>
  <depend>ament_index_cpp</depend>
  <depend>libopencv-dev</depend>

  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>rosapi</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
